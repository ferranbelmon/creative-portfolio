# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local video backups (Vimeo archive; not served on site)
public/images/projects/**/gallery/videos/backup/**
!public/images/projects/**/gallery/videos/backup/.gitkeep

# raw show recording, 2+ GB — too large for GitHub (100 MB limit)
public/images/projects/008-moonai-soundwaves-wellness/gallery/videos/LIVE FER ALEMAN - 1.mp4

# yt-dlp binary (downloaded locally)
scripts/bin/

# exported browser cookies (never commit)
scripts/cookies/*.txt
